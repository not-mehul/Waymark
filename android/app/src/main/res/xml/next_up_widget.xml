<?xml version="1.0" encoding="utf-8"?>
<!--
    Half an hour is the shortest period Android will honour for a widget; the
    app also refreshes it whenever a booking changes, so the countdown is never
    more than thirty minutes stale and the booking itself never is.

    It opens four cells wide and one high, and can be made as small as two by
    one or tall enough to list what comes after. The picker shows the drawn
    preview the app publishes on Android 15 and later, and previewLayout on
    Android 12 to 14.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="s"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview"
    android:minWidth="250dp"
    android:minHeight="70dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />

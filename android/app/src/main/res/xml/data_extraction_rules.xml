<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later. Nothing goes to cloud backup: the manifest's
    allowBackup="false" already says so, and this says it again. A
    device-to-device transfer, phone to phone during setup, carries the whole
    app across: every trip (in the WebView's IndexedDB, under app_webview),
    and the reminders and widget the shell keeps.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

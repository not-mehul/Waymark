<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's picture of the widget on Android 12 to 14, before it is placed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_eyebrow"
        android:textColor="@color/widget_ink_accent"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_title"
        android:textColor="@color/widget_ink"
        android:textSize="17sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="@string/widget_preview_detail"
        android:textColor="@color/widget_ink_dim"
        android:textSize="13sp" />
</LinearLayout>

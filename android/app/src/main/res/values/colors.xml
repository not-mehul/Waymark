<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window behind the WebView until the page paints, Dawn here and
        Dusk in values-night, so neither theme opens on the other's colour.
        They match the web app's --bg-grad-mid in each theme.
    -->
    <color name="window_dusk">#0F0D0B</color>
    <color name="window_dawn">#EFE6D8</color>
    <color name="app_surface">@color/window_dawn</color>

    <!-- The launcher mark, drawn by the system. -->
    <color name="launcher_background">#14110E</color>
    <color name="launcher_needle_lit">#D4A574</color>
    <color name="launcher_needle_shade">#F5ECD9</color>

    <!-- The home-screen widget, drawn by the launcher rather than the page. -->
    <color name="widget_surface">#F2EADC</color>
    <color name="widget_rim">#33A8763E</color>
    <!-- The widget picker's preview on Android 12 to 14; the widget itself sets its ink in code. -->
    <color name="widget_ink">#2A221B</color>
    <color name="widget_ink_dim">#6E6255</color>
    <color name="widget_ink_accent">#A8763E</color>
</resources>

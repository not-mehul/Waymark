<?xml version="1.0" encoding="utf-8"?>
<!--
    A surveyor's north needle: two long triangles meeting on a vertical axis,
    the figure at the centre of a compass rose.

    Drawn as two filled halves rather than strokes so it stays solid at every
    density, and sized to the 66dp safe zone of the 108dp adaptive canvas — the
    previous foreground put its ring at y 0–52 and its chevron at y 34–78, so
    the two halves of the mark never met.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The lit half: tip, right wing, tail. -->
    <path
        android:fillColor="@color/launcher_needle_lit"
        android:pathData="M54,26 L75,64 L54,82 Z" />

    <!-- The shaded half, in cream, so the needle reads as a solid with a
         highlight rather than as a flat diamond. -->
    <path
        android:fillColor="@color/launcher_needle_shade"
        android:pathData="M54,26 L33,64 L54,82 Z" />
</vector>

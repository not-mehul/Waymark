<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The network is for two opt-in extras only, the weather where the trip
        will be and the day's exchange rates, and is not touched until the
        traveler turns them on. Everything else works with the radio off.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the journey under way be shown as a Live Update on Android 16 and later. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
        Cloud backup stays off, as in the Kotlin app: an itinerary is not
        uploaded anywhere by the app or on its behalf. A device-to-device
        transfer carries everything across (data_extraction_rules), and a
        backup file can be saved anywhere from the shelf.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- configChanges: the WebView handles rotation, resizing (foldables,
             multi-window, large screens) and theme changes itself, so the page
             and its state are never torn down for them.
             singleTask: a reminder, the widget or something shared in reaches
             the running page through onNewIntent rather than a second WebView. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A confirmation email, shared in to be read for a flight. -->
            <intent-filter android:label="@string/share_add_to_trip">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
                A trip or a backup, exported from Waymark on this or another
                phone: shared in, or opened from a file manager or a mail app.
            -->
            <intent-filter android:label="@string/share_open_trip">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter android:label="@string/share_open_trip">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <!-- A trip's QR code, read by any camera app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="waymark" android:host="import" />
            </intent-filter>
        </activity>

        <!-- Woken by the alarm set for the next reminder or redraw. -->
        <receiver
            android:name=".alerts.ReminderReceiver"
            android:exported="false" />

        <!-- The home-screen widget (Jetpack Glance). -->
        <receiver
            android:name=".widget.NextUpWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_up_widget" />
        </receiver>

        <!--
            Grants a one-shot read on an exported file, and nothing else: the
            provider is not exported, so only an intent Waymark itself launches
            can hand out a URI.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

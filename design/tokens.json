{
  "$comment": "Editorial Dusk & Dawn. The single source for every colour, size and duration in Waymark, BookShelf and Ledger. Edit this file, then run `node design/build-tokens.mjs`. Never edit the generated files. See design/style.md.",
  "version": "1.0.0",
  "themes": {
    "dusk": {
      "selector": ":root, [data-theme=\"dark\"]",
      "colorScheme": "dark"
    },
    "dawn": {
      "selector": "[data-theme=\"light\"]",
      "colorScheme": "light"
    }
  },
  "color": {
    "bg-grad-top": {
      "dusk": "#14110e",
      "dawn": "#f3ece0",
      "usage": "Top stop of the page gradient (warmest). Never a flat fill."
    },
    "bg-grad-mid": {
      "dusk": "#0f0d0b",
      "dawn": "#efe6d8",
      "usage": "Middle stop of the page gradient; the solid page colour for native bars and launch screens."
    },
    "bg-grad-bot": {
      "dusk": "#0c0a08",
      "dawn": "#e9dfce",
      "usage": "Bottom stop of the page gradient (coolest)."
    },
    "text-strong": {
      "dusk": "#f5f5f4",
      "dawn": "#1c1917",
      "usage": "Highest emphasis: input values and active labels, on any page or panel surface."
    },
    "text-heading": {
      "dusk": "#f5ecd9",
      "dawn": "#211d17",
      "usage": "Headings, serif display and key numbers, on page and panel surfaces."
    },
    "text-body": {
      "dusk": "#e8e1d5",
      "dawn": "#3a342c",
      "usage": "Body copy on page, panel and modal surfaces."
    },
    "text-muted": {
      "dusk": "#d6d3d1",
      "dawn": "#4a443b",
      "usage": "Secondary text and inline strong, on page and panel surfaces."
    },
    "text-dim": {
      "dusk": "#a8a29e",
      "dawn": "#6a6257",
      "usage": "Labels, hints, footers. The dimmest readable text: 4.5:1 or better on every page and panel surface in both themes."
    },
    "text-faint": {
      "dusk": "#78716c",
      "dawn": "#938a7c",
      "usage": "Decoration only: separators, serial numbers, disabled text, placeholder. Below 4.5:1, so never for information."
    },
    "accent-amber": {
      "dusk": "#d4a574",
      "dawn": "#815c2d",
      "usage": "Primary accent for text and icons: the italic word in a title, links, active tab rule, icon tints. 4.5:1 on page surfaces in both themes."
    },
    "accent-bright": {
      "dusk": "#fcd34d",
      "dawn": "#e0a92a",
      "usage": "Fills only: primary button, FAB, active segment, selected chip. Never text in Dawn (1.7:1)."
    },
    "accent-bright-hover": {
      "dusk": "#fef3c7",
      "dawn": "#c89320",
      "usage": "Hover and press of bright fills."
    },
    "accent-sage": {
      "dusk": "#9fb3a0",
      "dawn": "#566856",
      "usage": "Secondary accent: progress fills, done states, status chips. 4.5:1 on page surfaces."
    },
    "danger": {
      "dusk": "#f87171",
      "dawn": "#b33528",
      "usage": "Destructive actions and error text, on page and panel surfaces."
    },
    "on-accent": {
      "dusk": "#1c1917",
      "dawn": "#1c1917",
      "usage": "Text and icons on accent-bright and accent-bright-hover fills (8:1+)."
    },
    "on-invert": {
      "dusk": "#1c1917",
      "dawn": "#f3ece0",
      "usage": "Text on a text-strong fill: the hovered secondary button."
    },
    "on-danger": {
      "dusk": "#1c1917",
      "dawn": "#f6efe2",
      "usage": "Text on a danger fill: the hovered danger button (5.3:1 or better)."
    },
    "border": {
      "dusk": "#44403c",
      "dawn": "#cdbfa6",
      "usage": "Solid control borders: inputs, toggles, segmented tracks, muted buttons."
    },
    "border-strong": {
      "dusk": "rgba(68,64,60,0.6)",
      "dawn": "rgba(120,105,80,0.45)",
      "usage": "Emphasised hairlines."
    },
    "border-soft": {
      "dusk": "rgba(68,64,60,0.5)",
      "dawn": "rgba(120,105,80,0.32)",
      "usage": "Panel borders, section dividers, the tab rail baseline."
    },
    "border-faint": {
      "dusk": "rgba(68,64,60,0.4)",
      "dawn": "rgba(120,105,80,0.22)",
      "usage": "Row dividers inside a panel, hairline grids."
    },
    "panel-bg": {
      "dusk": "rgba(20,17,14,0.6)",
      "dawn": "rgba(255,251,243,0.7)",
      "usage": "Standard panel and card fill."
    },
    "panel-bg-faint": {
      "dusk": "rgba(20,17,14,0.4)",
      "dawn": "rgba(255,251,243,0.45)",
      "usage": "Lighter zones: control tracks, stat tiles, thumbnail placeholders."
    },
    "input-bg": {
      "dusk": "rgba(12,10,8,0.8)",
      "dawn": "rgba(255,252,245,0.9)",
      "usage": "Inputs and the theme toggle track: recessed against the panel."
    },
    "chip-bg": {
      "dusk": "rgba(28,25,23,0.6)",
      "dawn": "rgba(245,238,226,0.85)",
      "usage": "Option chips at rest."
    },
    "chip-bg-hover": {
      "dusk": "rgba(28,25,23,0.85)",
      "dawn": "rgba(238,229,213,0.95)",
      "usage": "Option chips on hover and press."
    },
    "hover-bg": {
      "dusk": "rgba(41,37,36,0.4)",
      "dawn": "rgba(205,191,166,0.3)",
      "usage": "Generic hover and press wash for rows, tabs and icon buttons."
    },
    "disabled-bg": {
      "dusk": "rgba(41,37,36,0.6)",
      "dawn": "rgba(220,210,192,0.6)",
      "usage": "Disabled control fill, with text-faint text."
    },
    "sheet-bg": {
      "dusk": "#0f0d0b",
      "dawn": "#efe6d8",
      "usage": "Bottom sheets and full-screen flows (opaque)."
    },
    "modal-bg": {
      "dusk": "rgba(20,17,14,0.96)",
      "dawn": "rgba(252,248,240,0.98)",
      "usage": "Modal card and toast surface."
    },
    "modal-backdrop": {
      "dusk": "rgba(12,10,8,0.82)",
      "dawn": "rgba(60,52,40,0.45)",
      "usage": "Dimming layer behind modals and sheets."
    },
    "focus-ring": {
      "dusk": "#d4a574",
      "dawn": "#815c2d",
      "usage": "Keyboard focus outline, 2px with a 2px offset. Solid, so it holds 3:1 on every surface."
    },
    "error-bg": {
      "dusk": "rgba(69,10,10,0.2)",
      "dawn": "rgba(192,57,43,0.12)",
      "usage": "Error banner and invalid-field wash."
    },
    "notice-bg": {
      "dusk": "rgba(252,211,77,0.08)",
      "dawn": "rgba(224,169,42,0.12)",
      "usage": "Notice and highlight wash."
    },
    "success-bg": {
      "dusk": "rgba(159,179,160,0.12)",
      "dawn": "rgba(111,135,112,0.14)",
      "usage": "Confirmation wash: backup saved, sync done."
    },
    "scale-1": {
      "dusk": "#9fb3a0",
      "dawn": "#3f7a4a",
      "usage": "Quality scale, best: Ledger 'Exceptional' (85+). Strokes and markers only, always paired with the tier word."
    },
    "scale-2": {
      "dusk": "#b8c9a0",
      "dawn": "#66862f",
      "usage": "Quality scale: 'Strong' (72+)."
    },
    "scale-3": {
      "dusk": "#d4a574",
      "dawn": "#a4662c",
      "usage": "Quality scale: 'Decent' (58+)."
    },
    "scale-4": {
      "dusk": "#c08050",
      "dawn": "#b0552a",
      "usage": "Quality scale: 'Mixed' (42+)."
    },
    "scale-5": {
      "dusk": "#f87171",
      "dawn": "#b9382b",
      "usage": "Quality scale, worst: 'Challenging'."
    },
    "series-1": {
      "dusk": "rgba(212,165,116,0.85)",
      "dawn": "rgba(129,92,45,0.85)",
      "usage": "First chart series (amber). Bars in stats and rankings."
    },
    "series-2": {
      "dusk": "rgba(159,179,160,0.85)",
      "dawn": "rgba(86,104,86,0.85)",
      "usage": "Second chart series (sage)."
    },
    "series-3": {
      "dusk": "rgba(252,211,77,0.7)",
      "dawn": "rgba(224,169,42,0.8)",
      "usage": "Third chart series (bright amber)."
    },
    "series-4": {
      "dusk": "rgba(245,236,217,0.35)",
      "dawn": "rgba(120,95,50,0.35)",
      "usage": "Fourth series and 'Other' (cream)."
    },
    "chart-grid": {
      "dusk": "rgba(120,113,108,0.2)",
      "dawn": "rgba(120,105,80,0.25)",
      "usage": "Chart gridlines."
    },
    "chart-track": {
      "dusk": "rgba(68,64,60,0.5)",
      "dawn": "rgba(120,105,80,0.2)",
      "usage": "Empty part of meters, dials, sliders and the step rail."
    },
    "map-water": {
      "dusk": "#0b1114",
      "dawn": "#d7e0e0",
      "usage": "Map water: the one cool note in the system."
    },
    "map-land": {
      "dusk": "#262220",
      "dawn": "#f6efe2",
      "usage": "Map land."
    },
    "map-coast": {
      "dusk": "rgba(120,113,108,0.54)",
      "dawn": "rgba(147,138,124,0.6)",
      "usage": "Coastlines and borders on the map."
    },
    "map-grid": {
      "dusk": "rgba(120,113,108,0.2)",
      "dawn": "rgba(120,105,80,0.25)",
      "usage": "Graticule on the map."
    },
    "map-visited": {
      "dusk": "rgba(212,165,116,0.32)",
      "dawn": "rgba(176,125,62,0.28)",
      "usage": "Fill of visited countries and regions."
    },
    "map-route": {
      "dusk": "#d4a574",
      "dawn": "#815c2d",
      "usage": "Routes and place markers."
    },
    "scanner-bg": {
      "dusk": "#000000",
      "dawn": "#000000",
      "usage": "Camera viewfinder only: black in both themes."
    },
    "scanner-fg": {
      "dusk": "#ffffff",
      "dawn": "#ffffff",
      "usage": "Text over the camera viewfinder only."
    },
    "scanner-scrim": {
      "dusk": "rgba(0,0,0,0.45)",
      "dawn": "rgba(0,0,0,0.45)",
      "usage": "Dimming around the scan frame over the camera image."
    }
  },
  "rgb": {
    "accent-amber-rgb": {
      "dusk": "212, 165, 116",
      "dawn": "176, 125, 62",
      "usage": "Glows, tints and tinted borders: rgba(var(--accent-amber-rgb), a)."
    },
    "accent-bright-rgb": {
      "dusk": "252, 211, 77",
      "dawn": "224, 169, 42",
      "usage": "Bright tints."
    },
    "accent-sage-rgb": {
      "dusk": "159, 179, 160",
      "dawn": "111, 135, 112",
      "usage": "Sage glow and tints."
    },
    "danger-rgb": {
      "dusk": "248, 113, 113",
      "dawn": "192, 57, 43",
      "usage": "Danger tints and borders."
    },
    "cream-rgb": {
      "dusk": "245, 236, 217",
      "dawn": "120, 95, 50",
      "usage": "Cream glow and inset highlights."
    },
    "shadow-rgb": {
      "dusk": "0, 0, 0",
      "dawn": "90, 72, 44",
      "usage": "Shadow colour. Multiply alpha by --shadow-strength."
    }
  },
  "number": {
    "shadow-strength": {
      "dusk": 1,
      "dawn": 0.4,
      "usage": "Shadow opacity multiplier."
    }
  },
  "space": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "40px",
    "space-7": "56px"
  },
  "radius": {
    "radius": "2px",
    "radius-round": "50%"
  },
  "font": {
    "serif": "Fraunces, \"Iowan Old Style\", \"Apple Garamond\", Baskerville, Georgia, \"Noto Serif\", serif",
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"Roboto Mono\", \"Liberation Mono\", monospace"
  },
  "fontFaces": [
    {
      "family": "Fraunces",
      "file": "fraunces-latin-opsz-normal.woff2",
      "style": "normal",
      "weight": "100 900"
    },
    {
      "family": "Fraunces",
      "file": "fraunces-latin-opsz-italic.woff2",
      "style": "italic",
      "weight": "100 900"
    }
  ],
  "motion": {
    "ease-settle": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "dur-hover": "150ms",
    "dur-toggle": "220ms",
    "dur-settle": "260ms",
    "dur-enter": "320ms",
    "dur-exit": "160ms"
  },
  "layout": {
    "max-width": "880px",
    "breakpoint-narrow": "640px",
    "breakpoint-wide": "900px"
  },
  "contrast": {
    "$comment": "Pairs checked in both themes. Translucent backgrounds are composited over each page gradient stop. 'surfaces' expands to every page and panel surface.",
    "surfaces": [
      "bg-grad-top",
      "bg-grad-mid",
      "bg-grad-bot",
      "panel-bg",
      "sheet-bg",
      "modal-bg"
    ],
    "checks": [
      {
        "fg": [
          "text-strong",
          "text-heading",
          "text-body",
          "text-muted",
          "text-dim",
          "accent-amber",
          "accent-sage",
          "danger"
        ],
        "bg": "surfaces",
        "min": 4.5
      },
      {
        "fg": [
          "on-accent"
        ],
        "bg": [
          "accent-bright",
          "accent-bright-hover"
        ],
        "min": 4.5
      },
      {
        "fg": [
          "on-invert"
        ],
        "bg": [
          "text-strong"
        ],
        "min": 4.5
      },
      {
        "fg": [
          "on-danger"
        ],
        "bg": [
          "danger"
        ],
        "min": 4.5
      },
      {
        "fg": [
          "text-strong"
        ],
        "bg": [
          "input-bg"
        ],
        "min": 4.5
      },
      {
        "fg": [
          "scale-1",
          "scale-2",
          "scale-3",
          "scale-4",
          "scale-5",
          "map-route"
        ],
        "bg": [
          "bg-grad-mid"
        ],
        "min": 3
      },
      {
        "fg": [
          "focus-ring"
        ],
        "bg": [
          "bg-grad-mid"
        ],
        "min": 3
      }
    ]
  }
}
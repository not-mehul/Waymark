<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Waymark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dusk</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        What the activity opens in: the system splash in the window colour,
        handing over to Theme.Waymark once the first frame is ready.
    -->
    <style name="Theme.Waymark.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_dusk</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Waymark</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device transfer are disabled. The app stores travel plans
    that may be sensitive (reservations, personal preferences). Users can
    export their trips as markdown if needed.
-->
<full-backup-content>
    <exclude domain="database" path="waymark.db" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>

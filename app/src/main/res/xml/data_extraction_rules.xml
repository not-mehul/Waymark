<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later. Nothing goes to cloud backup — the manifest's
    allowBackup="false" already says so, and this says it again. A
    device-to-device transfer, phone to phone during setup, carries the whole
    app across: every trip, and the reminder and appearance settings.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

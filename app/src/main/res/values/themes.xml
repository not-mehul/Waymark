<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The platform theme exists only for the window between process start and
        the first Compose frame. Its colours mirror the Dusk tokens so the
        launch does not flash a stock grey.
    -->
    <style name="Theme.Waymark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dusk</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
